{
  "outputDirectory": "web_site",
  "cleanUrls": true,
  "routes": [
    { "src": "/docs", "dest": "/docs.html" },
    { "src": "/features", "dest": "/features.html" },
    { "src": "/benchmarks", "dest": "/benchmarks.html" },
    { "src": "/license", "dest": "/license.html" },
    { "src": "/privacy", "dest": "/privacy.html" },
    { "src": "/delete-account", "dest": "/delete-account.html" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
